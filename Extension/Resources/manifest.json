{
  "manifest_version": 3,
  "name": "DuoLargo",
  "description": "Versione diagnostica: misura come Safari dispone le pagine su iPhone Duo.",
  "version": "0.2.0",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["<all_urls>"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "toolbar-icon.png"
  },
  "permissions": ["nativeMessaging", "storage"]
}
