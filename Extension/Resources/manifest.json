{
  "manifest_version": 3,
  "name": "DuoLargo",
  "description": "Fa usare alle pagine tutto lo schermo esterno di iPhone Duo, anche sotto i comandi di Safari.",
  "version": "0.3.0",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "largo.js",
        "diag.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "toolbar-icon.png"
  },
  "permissions": [
    "nativeMessaging",
    "storage"
  ]
}